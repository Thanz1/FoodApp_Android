<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="16dp">

    <!-- Header: Tầng 1 - Tên ứng dụng -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍕 APP FOOD"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="12dp" />

    <!-- Header: Tầng 2 - Thanh công cụ chứa các nút bấm phân bổ đều -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Hồ sơ"
            android:textSize="13sp"
            android:backgroundTint="#9C27B0"
            android:textColor="@android:color/white"
            android:padding="0dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnCart"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Giỏ hàng"
            android:textSize="13sp"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            android:padding="0dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Đăng xuất"
            android:textSize="13sp"
            android:backgroundTint="#FF5722"
            android:textColor="@android:color/white"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Nút dành riêng cho ADMIN (Mặc định ẩn, chỉ Admin mới thấy) -->
    <Button
        android:id="@+id/btnAdminPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⭐ BẢNG ĐIỀU KHIỂN QUẢN TRỊ VIÊN (ADMIN)"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Tiêu đề danh sách món -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thực đơn hôm nay"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="8dp" />

    <!-- Danh sách món ăn -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFood"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>